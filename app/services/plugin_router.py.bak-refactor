"""Plugin Router — builds an execution plan from intent detection results.

Determines which downstream service should handle the message and whether
Hermes should be called for conversational reply.

Phase 2 rules:
  - Plugin command  → route to matched plugin, do NOT call Hermes
  - @bot mention     → route to Hermes for reply
  - Normal chat      → record only, no forwarding (for now)
"""

from __future__ import annotations

import logging
from dataclasses import dataclass, field

from app.services.intent_router import IntentResult

logger = logging.getLogger(__name__)


@dataclass
class ExecutionPlan:
    """Routing decision for a single message.

    Attributes:
        primary_handler: Which service handles this message.
            "astrbot" | "yunzai" | "hermes" | "klee_core" | "none"
        secondary_actions: Additional actions (e.g. "record", "log").
        call_hermes: Whether Hermes should generate a conversational reply.
        reason: Human-readable explanation of the routing decision.
    """
    primary_handler: str
    secondary_actions: list[str] = field(default_factory=list)
    call_hermes: bool = False
    reason: str = ""


class PluginRouter:
    """Routes messages based on intent detection results.

    Phase 2 routing logic:
        1. Plugin commands → matched handler only, Hermes stays silent.
        2. @bot mentions  → Hermes (future Phase 2 enhancement).
        3. Normal chat    → record only (no forwarding yet).
    """

    # Handlers that represent actual downstream services (not internal)
    DOWNSTREAM_HANDLERS = frozenset({"astrbot", "yunzai", "hermes", "meme"})

    def route(self, intent: IntentResult, mentions_bot: bool = False) -> ExecutionPlan:
        """Build an execution plan from intent detection results.

        Args:
            intent: Result from IntentRouter.detect().
            mentions_bot: Whether the bot was @mentioned in the message.

        Returns:
            ExecutionPlan with primary_handler and routing decisions.
        """
        if intent.is_command:
            handler = intent.primary_handler
            if handler in self.DOWNSTREAM_HANDLERS:
                logger.info(
                    "PluginRouter: command → %s (pattern: %s)",
                    handler, intent.matched_pattern,
                )
                return ExecutionPlan(
                    primary_handler=handler,
                    secondary_actions=["record"],
                    call_hermes=False,
                    reason=f"command_routed_to_{handler}",
                )
            elif handler == "klee_core":
                logger.info("PluginRouter: internal command → klee_core")
                return ExecutionPlan(
                    primary_handler="klee_core",
                    secondary_actions=["record"],
                    call_hermes=False,
                    reason="internal_command",
                )
            else:
                logger.warning(
                    "PluginRouter: unknown handler '%s', falling back to none", handler
                )
                return ExecutionPlan(
                    primary_handler="none",
                    secondary_actions=["record"],
                    call_hermes=False,
                    reason=f"unknown_handler_{handler}",
                )

        # Non-command message
        if mentions_bot:
            # Phase 2 enhancement: route @bot mentions to Hermes
            # For now, also just record
            logger.info("PluginRouter: @bot mention → record only (hermes phase 2)")
            return ExecutionPlan(
                primary_handler="none",
                secondary_actions=["record", "pending_hermes"],
                call_hermes=False,
                reason="at_mention_phase2_deferred",
            )

        # Normal chat — record only, no forwarding
        logger.debug("PluginRouter: normal chat → record only")
        return ExecutionPlan(
            primary_handler="none",
            secondary_actions=["record"],
            call_hermes=False,
            reason="non_command_quiet",
        )
