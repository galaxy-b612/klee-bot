"""API Proxy — routes API action requests from downstream to NapCat HTTP API.

When AstrBot/Yunzai sends an action request via WebSocket, the proxy:
  1. Calls NapCat's HTTP API to execute the action
  2. Returns the response with echo preserved back to the requesting downstream
"""

from __future__ import annotations

import logging
from typing import Optional

from app.services.onebot_bridge.types import OneBotAPIRequest, OneBotAPIResponse
from app.services.onebot_bridge.upstream import UpstreamNapCatClient
from app.services.onebot_bridge.event_bus import OneBotEventBus
from app.services.onebot_bridge.diagnostics import log_upstream_forward, log_upstream_response

logger = logging.getLogger(__name__)


class OneBotAPIProxy:
    """Handles API action requests from downstream services.

    Routes actions to NapCat via UpstreamNapCatClient.call_api() and
    sends responses back to the requesting downstream via OneBotEventBus.

    Usage:
        proxy = OneBotAPIProxy(upstream=upstream_client, event_bus=bus)
        # Pass proxy.handle_api as on_api_request callback to the EventBus
    """

    def __init__(
        self,
        upstream: UpstreamNapCatClient,
        event_bus: OneBotEventBus,
        bot_http_map: dict[int, str] | None = None,
    ):
        self._upstream = upstream
        self._event_bus = event_bus
        self._bot_http_map = bot_http_map or {}
        # Track last known self_id per group for API routing
        self._group_bot: dict[int, int] = {}

    def record_event(self, group_id: int, self_id: int):
        """Record which bot handles a given group (called on each upstream event)."""
        if group_id and self_id:
            self._group_bot[group_id] = self_id

    async def handle_api(self, request: OneBotAPIRequest, source: str):
        """Handle an API action request from a downstream.

        Called by the EventBus when a downstream sends an action request.
        Proxies the request to NapCat and sends the response back.
        Routes to the correct NapCat instance based on group context.

        Args:
            request: The parsed API request.
            source: Name of the downstream that sent it (e.g. "astrbot").
        """
        # Log: what the downstream sent us
        logger.warning(
            "API-DBG: action=%s echo=%s src=%s keys=%s",
            request.action, request.echo, source, list(request.params.keys()),
        )

        # Route to correct NapCat instance based on group context
        group_id = request.params.get("group_id", 0)
        self_id = self._group_bot.get(group_id)
        if self_id and self_id in self._bot_http_map:
            correct_url = self._bot_http_map[self_id]
            if correct_url != self._upstream.napcat_http_url:
                logger.debug("Routing API %s to NapCat %s (self_id=%s)", request.action, correct_url, self_id)
                self._upstream.napcat_http_url = correct_url

        # Log: what we are forwarding to NapCat (zero-loss check)
        log_upstream_forward(request.params, request.action, str(request.echo))

        response = await self._upstream.call_api(request)

        # Log: what NapCat returned
        log_upstream_response(response, request.action, str(request.echo))

        # Always preserve echo so the downstream can match the response
        response.echo = request.echo

        ok = await self._event_bus.send_response(source, response)
        if not ok:
            logger.warning(
                "Failed to send API response to %s for %s",
                source, request.action,
            )

    async def respond_error(
        self,
        request: OneBotAPIRequest,
        source: str,
        wording: str,
    ):
        """Send an error response back without calling NapCat."""
        response = OneBotAPIResponse(
            status="failed", retcode=1,
            wording=wording, echo=request.echo,
        )
        await self._event_bus.send_response(source, response)
