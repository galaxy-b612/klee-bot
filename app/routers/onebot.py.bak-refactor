"""OneBot event receiver router.

POST /onebot/event — receives OneBot v11 message events from NapCat,
normalizes them, stores to database, runs intent detection + plugin routing,
and optionally routes normal chat to Hermes via ReplyGate.
"""

from __future__ import annotations

import logging

from fastapi import APIRouter, Depends, HTTPException, Request, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.config import get_bot_by_self_id
from app.database import get_session
from app.schemas.onebot import OneBotEvent
from app.services.forward_service import schedule_forward
from app.services.group_activity import GroupActivityTracker
from app.services.intent_router import IntentRouter
from app.services.message_service import create_message_from_event
from app.services.plugin_router import PluginRouter
from app.services.reply_gate import NormalizedMessage, ReplyGate, UserProfile

logger = logging.getLogger(__name__)

router = APIRouter(tags=["onebot"])

# Global singletons
_intent_router: IntentRouter | None = None
_plugin_router: PluginRouter | None = None
_reply_gate: ReplyGate | None = None
_tracker: GroupActivityTracker | None = None


def _get_intent_router() -> IntentRouter:
    global _intent_router
    if _intent_router is None:
        _intent_router = IntentRouter()
    return _intent_router


def _get_plugin_router() -> PluginRouter:
    global _plugin_router
    if _plugin_router is None:
        _plugin_router = PluginRouter()
    return _plugin_router


def _get_reply_gate() -> ReplyGate:
    global _reply_gate, _tracker
    if _reply_gate is None:
        _tracker = GroupActivityTracker()
        _reply_gate = ReplyGate(tracker=_tracker)
    return _reply_gate


@router.post("/onebot/event", status_code=status.HTTP_200_OK)
async def receive_onebot_event(
    request: Request,
    event: OneBotEvent,
    session: AsyncSession = Depends(get_session),
):
    """Receive a OneBot v11 message event from NapCat."""
    # ── Validation ──

    if event.post_type != "message":
        logger.debug("Ignoring non-message event: post_type=%s", event.post_type)
        return {"status": "ignored", "reason": f"post_type={event.post_type}"}

    if event.message_type not in ("group", "private"):
        logger.debug("Ignoring message_type=%s", event.message_type)
        return {"status": "ignored", "reason": f"message_type={event.message_type}"}

    bot = get_bot_by_self_id(event.self_id)
    if bot is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"No enabled bot found for self_id={event.self_id}",
        )

    if event.message_type == "group" and event.group_id:
        if event.group_id not in bot.groups:
            return {
                "status": "ignored",
                "reason": f"group {event.group_id} not managed by {bot.bot_id}",
            }

    # ── Normalize & store ──

    message = await create_message_from_event(session, event, bot.bot_id)

    # ── Activity tracking ──

    is_media = message.message_type in ("image", "voice", "video")
    gate = _get_reply_gate()
    gate.record_message(message.group_id, is_media=is_media)

    # ── Intent detection + plugin routing ──

    intent_router = _get_intent_router()
    plugin_router = _get_plugin_router()

    intent_result = intent_router.detect(
        message.normalized_content,
        mentions_bot=message.mentions_bot,
    )
    plan = plugin_router.route(intent_result, mentions_bot=message.mentions_bot)

    # ── Build event payload ──

    event_payload = event.model_dump(exclude_none=True, by_alias=False)
    event_payload["_klee_bot_id"] = bot.bot_id
    event_payload["_klee_message_id"] = message.id
    event_payload["_klee_primary_handler"] = plan.primary_handler

    reply_gate_result = None

    # ── Routing ──

    if plan.primary_handler == "none":
        # ── Normal chat → ReplyGate ──
        reply_gate_result = gate.score(
            NormalizedMessage(
                text=message.normalized_content,
                mentions_bot=message.mentions_bot,
                is_reply_to_bot=False,
                user_id=message.user_id,
                group_id=message.group_id,
            ),
            # TODO: load real UserProfile from affection system
            user=UserProfile(user_id=message.user_id, favor_score=0.0),
        )

        logger.info(
            "ReplyGate: score=%d should=%s trigger=%s reasons=%s",
            reply_gate_result.score,
            reply_gate_result.should_reply,
            reply_gate_result.trigger_level,
            reply_gate_result.reason,
        )

        if reply_gate_result.should_reply:
            # Score >= 80 → route to Hermes
            plan.primary_handler = "hermes"
            plan.call_hermes = True
            plan.reason = "reply_gate_triggered"
            schedule_forward(event_payload, bot, targets=["hermes"])
            gate.record_reply(message.group_id)

        elif reply_gate_result.trigger_level == "delayed":
            # Score 50-79 → create delayed task (Phase 3)
            logger.debug("ReplyGate: deferred — score in 50-79 range")

        # else: score < 50 → record only

    elif plan.primary_handler in ("astrbot", "yunzai", "meme"):
        # ── Plugin command → forward to matched handler ──
        schedule_forward(event_payload, bot, targets=[plan.primary_handler])

    elif plan.primary_handler == "hermes":
        schedule_forward(event_payload, bot, targets=["hermes"])
        gate.record_reply(message.group_id)

    elif plan.primary_handler == "klee_core":
        logger.info("Internal klee_core command — pending implementation")

    return {
        "status": "ok",
        "message_id": message.id,
        "message_type": message.message_type,
        "bot_id": bot.bot_id,
        "routing": {
            "is_command": intent_result.is_command,
            "primary_handler": plan.primary_handler,
            "call_hermes": plan.call_hermes,
            "reason": plan.reason,
        },
        **(
            {
                "reply_gate": {
                    "score": reply_gate_result.score,
                    "should_reply": reply_gate_result.should_reply,
                    "trigger_level": reply_gate_result.trigger_level,
                    "reason": reply_gate_result.reason,
                }
            }
            if reply_gate_result
            else {}
        ),
    }
